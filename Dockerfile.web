# syntax=docker/dockerfile:1
# 管理后台 SPA 镜像：Vben 5 monorepo 构建 web-antd → nginx 托管
#
# 上游把后台前端放在 frontend/ 这个 pnpm monorepo 里，仓库不提交 dist，
# 所以只能在构建期装依赖再编译。两处必须覆盖的运行时配置：
#   VITE_GLOB_API_URL  上游 .env.production 里是 https://mock-napi.vben.pro/api（demo 地址）
#   VITE_BASE          改成 /admin/ 才能挂在子路径下（配合 hash 路由，无需服务端 rewrite）
FROM node:24-bookworm AS build

ARG FLYCMS_REF=master
WORKDIR /src

RUN git clone --filter=blob:none --no-checkout https://github.com/sunkaifei/FlyCms.git /src \
 && cd /src \
 && git fetch --depth 1 origin "${FLYCMS_REF}" \
 && git checkout --detach FETCH_HEAD \
 && echo "built from $(git rev-parse HEAD)"

RUN corepack enable && corepack prepare pnpm@11.16.0 --activate && node -v && pnpm -v

WORKDIR /src/frontend

# monorepo 依赖量大（vben 全家桶），用 cache mount 让重复构建不必重下
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# 不能用「给过程环境变量」的方式改这两个值：根脚本 build:antd 走的是 turbo build，
# turbo 默认 strict 模式会剥掉未在 globalEnv 声明的变量（上游 turbo.json 只声明了 NODE_ENV），
# VITE_BASE/VITE_GLOB_API_URL 到不了 vite，结果 base 仍是 /，SPA 会去请求 /js/* 而 404。
# 所以直接改写 .env.production —— @vben/vite-config 的 loadEnv 用 dotenv 读这些文件，路径确定。
RUN sed -i 's|^VITE_BASE=.*|VITE_BASE=/admin/|' apps/web-antd/.env.production \
 && sed -i 's|^VITE_GLOB_API_URL=.*|VITE_GLOB_API_URL=/api|' apps/web-antd/.env.production \
 && grep -E '^(VITE_BASE|VITE_GLOB_API_URL|VITE_ROUTER_HISTORY)=' apps/web-antd/.env.production \
 && pnpm build:antd \
 && ls -la apps/web-antd/dist \
 && ls apps/web-antd/dist | head -20
# 构建后立刻验一遍 base 真的生效了：index.html 里的资源必须是 /admin/ 前缀。
# 这一条如果破了，后台在浏览器里就是白屏，但 HTTP 仍然 200，回归测不出来，所以必须在这里断死。
RUN grep -q '"/admin/' /src/frontend/apps/web-antd/dist/index.html \
 || (echo "构建产物 base 不是 /admin/，后台会白屏"; head -5 /src/frontend/apps/web-antd/dist/index.html; exit 1)

FROM nginx:1.27-alpine

# dist 落到 /usr/share/nginx/admin/，配合 nginx.conf 里 `root /usr/share/nginx` 的 /admin/ location
COPY --from=build /src/frontend/apps/web-antd/dist/ /usr/share/nginx/admin/
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
